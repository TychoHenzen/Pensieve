# .step-session/: scratch state written by the step-by-step orchestrator skill
.step-session/

# __pycache__/: bytecode cache written by the Python interpreter
__pycache__/

# .pytest_cache/: cache written by pytest between runs
.pytest_cache/

# *.egg-info/: metadata written by setuptools when the project installs
*.egg-info/

# .venv/: the local virtual environment created by python -m venv
.venv/

# **/data/corpus/: prose snapshot written by scripts/fetch_corpus.py
**/data/corpus/

# .spec-extract/: scratch output written by the spec-extract skill
.spec-extract/

# .coverage: coverage data written by pytest-cov / coverage.py
.coverage
.coverage.*
coverage.xml
htmlcov/

# Ruff and Pyright local caches
.ruff_cache/
.pyright/

# Build artifacts
build/
dist/
*.whl

# Local environment files. Keep the example configuration visible.
.env
.env.*
!.env.example

# Serena local state. Intentional project metadata and memories remain tracked.
.serena/cache/
.serena/logs/
.serena/project.local.yml

# .idea/: project config written by PyCharm / IntelliJ
.idea/

# data/MNIST/: MNIST dataset downloaded by torchvision when data_source="mnist"
data/MNIST/

# data/FashionMNIST/: FashionMNIST dataset downloaded by torchvision when data_source="fashion-mnist"
data/FashionMNIST/

# .claude/settings.local.json: local Claude Code settings (per-machine)
.claude/settings.local.json

# gate_results/: output written by scripts/run_gate.py
gate_results/

# checkpoints/: training checkpoint files written by train/run_training.py
checkpoints/

# *.jsonl: training output logs written by experimental training runs
*.jsonl

# *.log~: backup files created during training script development
*.log~
.trainability_paths.txt
